---
import { site } from '../lib/site';
import { waLink } from '../lib/whatsapp';
import { getAllCars } from '../lib/cars';
const a = site.address;
const { instagram, tiktok } = site.social;
const utama = getAllCars()[0];
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__mark"><img src="/logo-omoda-jaecoo.png" alt="OMODA | JAECOO" width="882" height="49" /></div>
    <p class="footer__addr">
      {site.dealerName}<br />
      {a.street}, {a.locality}, {a.region} {a.postalCode}
    </p>
    <div class="footer__social">
      {tiktok && (
        <a href={tiktok} target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .77-5.06V9.68a5.67 5.67 0 0 0-.77-.05A5.68 5.68 0 1 0 15.54 15.3V8.9a7.34 7.34 0 0 0 4.3 1.38V7.19a4.29 4.29 0 0 1-3.24-1.37z"/></svg>
        </a>
      )}
      {instagram && (
        <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 2.16c-3.15 0-3.5.01-4.74.07-1.14.05-1.76.24-2.17.4-.55.21-.94.47-1.35.88-.41.41-.67.8-.88 1.35-.16.41-.35 1.03-.4 2.17-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05 1.14.24 1.76.4 2.17.21.55.47.94.88 1.35.41.41.8.67 1.35.88.41.16 1.03.35 2.17.4 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c1.14-.05 1.76-.24 2.17-.4.55-.21.94-.47 1.35-.88.41-.41.67-.8.88-1.35.16-.41.35-1.03.4-2.17.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-1.14-.24-1.76-.4-2.17-.21-.55-.47-.94-.88-1.35-.41-.41-.8-.67-1.35-.88-.41-.16-1.03-.35-2.17-.4-1.24-.06-1.59-.07-4.74-.07zm0 3.68a6 6 0 1 1 0 12 6 6 0 0 1 0-12zm0 2.16a3.84 3.84 0 1 0 0 7.68 3.84 3.84 0 0 0 0-7.68zm6.24-.66a1.4 1.4 0 1 1 0-2.8 1.4 1.4 0 0 1 0 2.8z"/></svg>
        </a>
      )}
    </div>
    <div class="footer__links">
      <a href="/">Beranda</a>
      <a href={`/mobil/${utama.slug}`}>{utama.nama}</a>
      <a href="/#reward">Reward</a>
      <a href="/tentang">Tentang &amp; Kontak</a>
      <a href={waLink()} target="_blank" rel="noopener">WhatsApp</a>
    </div>
    <small>Dealer resmi. Harga dan spesifikasi dapat berubah sewaktu-waktu.</small>
  </div>
</footer>
