---
/* =============================================================================
   Lineup beranda situs dealer.
   Satu tingkat di atas situs sales: model pertama tampil sebagai kartu sorot
   yang lebih besar, sisanya dalam kisi. Spesifikasi lengkap TIDAK ditaruh di
   sini — hanya dua angka kunci sebagai pembanding cepat. Selebihnya di
   halaman model.
   ============================================================================ */
import { getAllCars, teksHarga, punyaHarga, labelStatus, merek } from '../lib/cars';
import { site } from '../lib/site';
import { waLink, pesanPenawaran } from '../lib/whatsapp';
const cars = getAllCars();
---
<section class="lineup" id="lineup">
  <div class="wrap">
    <div class="lineup__head">
      <p class="eyebrow">Model</p>
      <h2 class="sec-title">{cars.length > 1 ? 'Lineup OMODA & JAECOO' : cars[0].nama}</h2>
      <p class="sec-lede">
        Seluruh unit tersedia untuk test drive dan pengiriman ke {site.address.region}.
        Klik model untuk spesifikasi lengkap, pilihan warna, dan simulasi kredit.
      </p>
    </div>

    <div class="lineup__daftar">
      {cars.map((car, i) => {
        const detail = `/mobil/${car.slug}`;
        const angka = (car.angka ?? []).slice(0, 2);
        return (
          <article class:list={['kartu', i === 0 && 'kartu--sorot']}>
            <a class="kartu__tautan" href={detail} aria-label={`Lihat detail ${car.nama}`}>
              <div class="kartu__media">
                <img src={car.gambar.thumbnail}
                     alt={`${car.nama} tampak tiga perempat depan.`}
                     loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              </div>
              <div class="kartu__isi">
                <p class="kartu__chip">{merek(car)} <span>&middot;</span> {labelStatus(car)}</p>
                <h3 class="kartu__nama">{car.nama}</h3>
                <p class="kartu__tagline">{car.tagline}</p>
                <p class:list={['kartu__harga', !punyaHarga(car) && 'kartu__harga--menunggu']}>
                  {teksHarga(car)}
                </p>
                {punyaHarga(car) && (
                  <p class="kartu__ket">Mulai dari, OTR {site.address.locality}</p>
                )}
                {angka.length > 0 && (
                  <dl class="kartu__angka">
                    {angka.map((a) => (
                      <div>
                        <dt>{a.label}</dt>
                        <dd>{a.nilai}{a.satuan && <span>{a.satuan}</span>}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            </a>
            <div class="kartu__kaki">
              <a class="kartu__aksi" href={detail}>Lihat detail</a>
              <a class="kartu__wa" href={waLink(pesanPenawaran(car.namaPendek))}
                 target="_blank" rel="noopener"
                 aria-label={`Tanya ${car.nama} lewat WhatsApp`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.42-9.41a9.36 9.36 0 0 1 6.66 2.76 9.34 9.34 0 0 1 2.76 6.66c0 5.19-4.23 9.41-9.43 9.41zM20.5 3.55A11.28 11.28 0 0 0 12.04.05C5.8.05.72 5.13.72 11.37c0 2 .52 3.95 1.52 5.67L.63 23l6.1-1.6a11.3 11.3 0 0 0 5.31 1.35h.01c6.24 0 11.32-5.08 11.32-11.32 0-3.02-1.18-5.87-3.32-8.01z"/></svg>
                <span>Tanya</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
